        <div id="loader">
            <div class="line-scale-pulse-out">
                <div></div>
                <div></div>
                <div></div>
                <div></div>
                <div></div>
            </div>
        </div>
    </div>


    <!-- Java Script
    ================================================== -->
    <script src="../homepage_template/js/jquery-3.2.1.min.js"></script>
    <script src="../homepage_template/js/plugins.js"></script>
    <script src="../homepage_template/js/main.js"></script>

</body>

