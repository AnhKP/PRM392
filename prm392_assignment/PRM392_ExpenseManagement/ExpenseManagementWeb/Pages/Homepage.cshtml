    <!-- about
    ================================================== -->
    <section id='about' class="s-about">

        <div class="row section-header has-bottom-sep" data-aos="fade-up">
            <div class="col-full">
                <h3 class="subhead subhead--dark">Hello There</h3>
                <h1 class="display-1 display-1--light">We Are FreshTrack</h1>
            </div>
        </div> <!-- end section-header -->

        <div class="row about-desc" data-aos="fade-up">
            <div class="col-full">
                <p>
                    Với ý tưởng áp dụng công nghệ vào đời sống và nâng cao ý thức bảo vệ môi trường, FreshTrack đã ra đời với sứ mệnh 'Track Your Food, Reduce Your Waste' – giúp bạn quản lý thực phẩm một cách thông minh, giảm thiểu lãng phí và xây dựng một cuộc sống bền vững hơn.
                </p>
            </div>
        </div> <!-- end about-desc -->

        <div class="row about-stats stats block-1-4 block-m-1-2 block-mob-full" data-aos="fade-up">

            <div class="col-block stats__col">
                <div class="stats__count">250</div>
                <h5>Items Tracked</h5>
            </div>
            <div class="col-block stats__col">
                <div class="stats__count">75</div>
                <h5>Fridges Managed</h5>
            </div>
            <div class="col-block stats__col">
                <div class="stats__count">300</div>
                <h5>Meals Creation</h5>
            </div>
            <div class="col-block stats__col">
                <div class="stats__count">150</div>
                <h5>Happy Client</h5>
            </div>


        </div> <!-- end about-stats -->

        <div class="about__line"></div>

    </section> <!-- end s-about -->
    <!-- services
    ================================================== -->
    <section id='services' class="s-services">

        <div class="row section-header has-bottom-sep" data-aos="fade-up">
            <div class="col-full">
                <h3 class="subhead">What We Do</h3>
                <h1 class="display-2">We’ve got everything
                    you need to "master" your fridge</h1>

            </div>
        </div> <!-- end section-header -->

        <div class="row services-list block-1-2 block-tab-full">

            <div class="col-block service-item" data-aos="fade-up">
                <div class="service-icon">
                    <img src="../homepage_template/1.jpg" alt="Homepage">
                </div>
                <div class="service-text">
                    <h3 class="h2">Control item in your refrigation</h3>
                    <p>
                        By keeping track of each product's status, you can 
                        easily identify items nearing their expiration dates
                        and plan their usage effectively. This control system 
                        not only helps reduce waste but also protects the health
                        of you and your family. Make sure to regularly check and
                        adjust your refrigerator’s temperature to keep your food 
                        fresh and safe.
                    </p>

                </div>
            </div>

            <div class="col-block service-item" data-aos="fade-up">
                <div class="service-icon">
                    <img src="../homepage_template/5.jpg" alt="Homepage">
                </div>
                <div class="service-text">
                    <h3 class="h2">Recommend Cooking</h3>
                    <p>
                        The Cooking Recommend feature allows you to choose from the ingredients
                        available in your refrigerator and receive tailored meal suggestions.
                        Simply select the items you have on hand, and our system will generate
                        a variety of delicious recipes that utilize those ingredients. 
                        This not only helps you make the most of what you already have but
                        also inspires creativity in your cooking. Whether you're looking for 
                        a quick weeknight dinner or an elaborate dish for a special occasion, 
                        you'll find plenty of options to satisfy your cravings and reduce food waste.
                    </p>

                </div>
            </div>

            <div class="col-block service-item" data-aos="fade-up">
                <div class="service-icon">
                    <img src="../homepage_template/3.jpg" alt="Homepage">
                </div>
                <div class="service-text">
                    <h3 class="h2">To-Buy List</h3>
                    <p>
                        The To Buy List feature enhances your cooking experience by allowing you to create
                        a personalized shopping list based on the recipes you wish to try. When you select 
                        a meal from the Cooking Recommend suggestions, you can easily add any missing 
                        ingredients to your To Buy List. This streamlined process ensures that you never 
                        forget essential items while shopping, making meal preparation more efficient. 
                        Plus, with the ability to categorize items and check them off as you shop, you 
                        can save time and reduce food waste by only purchasing what you truly need.
                    </p>

                </div>
            </div>

            <div class="col-block service-item" data-aos="fade-up">
                <div class="service-icon">
                    <img src="../homepage_template/4.jpg" alt="Homepage">
                </div>
                <div class="service-text">
                    <h3 class="h2">Report Budget</h3>
                    <p>
                        The Report Budget feature is designed to help you manage your food expenses effectively by
                        providing a clear overview of your spending on groceries and dining out. With this tool,
                        you can track your monthly food costs, set a budget, and identify areas where you can save.
                        By analyzing your spending patterns, you can make informed decisions about meal planning
                        and grocery shopping, ensuring that you stay within your budget while still enjoying a variety 
                        of nutritious meals. This way, you can enjoy delicious food without compromising your financial health.
                    </p>


                </div>
            </div>
            

            

        </div> <!-- end services-list -->
        <div class="home-content__buttons" >
            <a href="/Common_Page/SignUp" class=" btn btn--stroke" style="border-color: forestgreen;
                                                                            color: green;
                                                                            margin-left: 41%;
                                                                            width: 19%;
                                                                            font-size: larger;">
                Enjoy with us
            </a>

        </div>
    </section> <!-- end s-services -->
    
    <!-- works-->
    

    <section id="contact" class="s-contact">

        <div class="overlay"></div>
        <div class="contact__line"></div>

        <div class="row section-header" data-aos="fade-up">
            <div class="col-full">
                <h3 class="subhead">Contact Us</h3>
                <h1 class="display-2 display-2--light">When you have any question or just say hello</h1>
            </div>
        </div>

        <div class="row contact-content" data-aos="fade-up">

            <div class="contact-primary">

                <h3 class="h6">Send Us A Message</h3>

                <form name="contactForm" id="contactForm" method="post" action="" novalidate="novalidate">
                    <fieldset>

                        <div class="form-field">
                            <input name="contactName" type="text" id="contactName" placeholder="Your Name" value="" minlength="2" required="" aria-required="true" class="full-width">
                        </div>
                        <div class="form-field">
                            <input name="contactEmail" type="email" id="contactEmail" placeholder="Your Email" value="" required="" aria-required="true" class="full-width">
                        </div>
                        <div class="form-field">
                            <input name="contactSubject" type="text" id="contactSubject" placeholder="Subject" value="" class="full-width">
                        </div>
                        <div class="form-field">
                            <textarea name="contactMessage" id="contactMessage" placeholder="Your Message" rows="10" cols="50" required="" aria-required="true" class="full-width"></textarea>
                        </div>
                        <div class="form-field">
                            <button class="full-width btn--primary">Submit</button>
                            <div class="submit-loader">
                                <div class="text-loader">Sending...</div>
                                <div class="s-loader">
                                    <div class="bounce1"></div>
                                    <div class="bounce2"></div>
                                    <div class="bounce3"></div>
                                </div>
                            </div>
                        </div>

                    </fieldset>
                </form>

                <!-- contact-warning -->
                <div class="message-warning">
                    Something went wrong. Please try again.
                </div>

                <!-- contact-success -->
                <div class="message-success">
                    Your message was sent, thank you!<br>
                </div>

            </div> <!-- end contact-primary -->

            <div class="contact-secondary">
                <div class="contact-info">

                    <h3 class="h6 hide-on-fullwidth">Contact Info</h3>

                    <div class="cinfo">
                        <h5>Where to Find Us</h5>
                        <p>
                            FPT University<br>
                            Hola, Ha Noi<br>
                            Viet Nam 
                        </p>
                    </div>

                    <div class="cinfo">
                        <h5>Email Us At</h5>
                        <p>
                            contact@freshtrack.com<br>
                            info@freshtrack.com
                        </p>
                    </div>

                    <div class="cinfo">
                        <h5>Call Us At</h5>
                        <p>
                            Phone: (+84) 123 456 789<br>
                            Mobile: (+84) 123 456 987<br>
                        </p>
                    </div>

                    <ul class="contact-social">
                        <li>
                            <a href="#"><i class="fa fa-facebook" aria-hidden="true"></i></a>
                        </li>
                        <li>
                            <a href="#"><i class="fa fa-twitter" aria-hidden="true"></i></a>
                        </li>
                        <li>
                            <a href="#"><i class="fa fa-instagram" aria-hidden="true"></i></a>
                        </li>
                        <li>
                            <a href="#"><i class="fa fa-behance" aria-hidden="true"></i></a>
                        </li>
                        <li>
                            <a href="#"><i class="fa fa-dribbble" aria-hidden="true"></i></a>
                        </li>
                    </ul> <!-- end contact-social -->

                </div> <!-- end contact-info -->
            </div> <!-- end contact-secondary -->

        </div> <!-- end contact-content -->

    </section> <!-- end s-contact -->
    <!-- footer
    ================================================== -->
